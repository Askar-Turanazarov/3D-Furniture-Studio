# Copy to .env and fill in your own values (.env and .env.local are not committed). No real values here.
# Token for the manager page /admin.html — at least 16 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
# PORT=3000
# Token for the MCP server mcp-server/ (port 3001) — 32–64 characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=
# DATA_DIR=            (folder for local order files and apartment statuses; default ./data)

# Vercel sets these itself (Storage → Neon, Storage → Blob); `vercel env pull` writes them to .env.local.
# Without them orders and statuses are files on disk (order.json, orders/, data/) and texture sets go to public/textures/lib/.
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=   (older Blob stores; newer ones give BLOB_STORE_ID and sign in with VERCEL_OIDC_TOKEN)
# BLOB_STORE_ID=

# Only for `npm test`: a separate Postgres database for test/db.test.js (skipped when empty).
# TEST_DATABASE_URL=
