# Copy to .env and set your own values (.env and .env.local are not committed).
# Token for the manager page /admin.html — a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=change-me-to-a-long-random-string
# PORT=3000

# Vercel sets these itself (Storage → Neon, Storage → Blob); `vercel env pull` writes them to .env.local.
# Without them orders and statuses are files on disk (order.json, orders/, data/) and texture sets go to public/textures/lib/.
# DATABASE_URL=
# BLOB_READ_WRITE_TOKEN=
