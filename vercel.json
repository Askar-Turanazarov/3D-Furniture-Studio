{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/vendor-three.js",
  "regions": ["fra1"],
  "functions": {
    "server.js": {
      "maxDuration": 60,
      "excludeFiles": "{public/vendor/**,public/js/**,public/css/**,public/textures/sets/**,public/textures/lib/**}",
      "includeFiles": "{public/index.html,catalog.json,templates.json,apartments.json,buildings/**,public/textures/library.json,public/textures/README.md,public/textures/floor/**,public/textures/wall/**,public/textures/wood/**,public/textures/fabric/**}"
    }
  },
  "headers": [
    { "source": "/vendor/three/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, s-maxage=31536000" }] },
    { "source": "/textures/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }] }
  ]
}
